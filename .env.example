# PostgreSQL connection URL (with pgvector-enabled database)
DB_URL=postgresql://forge:forge@db:5432/forge

# Langfuse observability keys
# Obtain from your Langfuse project settings at http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=http://langfuse:3000

# Langfuse internal database credentials
LANGFUSE_DB_USER=langfuse
LANGFUSE_DB_PASSWORD=langfuse
LANGFUSE_DB_NAME=langfuse
LANGFUSE_NEXTAUTH_SECRET=changeme
LANGFUSE_SALT=changeme

# App database credentials
POSTGRES_USER=forge
POSTGRES_PASSWORD=forge
POSTGRES_DB=forge

# vLLM / OpenAI-compatible endpoint (local vLLM server via host.docker.internal)
OPENAI_API_BASE=http://host.docker.internal:8000/v1
OPENAI_API_KEY=dummy

# LLM model name served by vLLM
LLM_MODEL=mistralai/Mistral-7B-Instruct-v0.2

# Maximum number of query-rewrite retries before giving up
MAX_RETRY_COUNT=3
